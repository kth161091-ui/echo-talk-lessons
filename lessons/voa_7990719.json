  "thumbnailUrl": "https://gdb.voanews.com/64180526-8845-4728-03e3-08dd4a817621_tv_w1080_h608.jpg",
  "language": "en",
  "translationLanguage": "ko",
  "sentences": [
    {
      "text": "Welcome to English in a Minute.",
      "startMs": 3920,
      "endMs": 6300
    },
    {
      "text": "Some people use a large ball for exercise.",
      "startMs": 7230,
      "endMs": 11010
    },
    {
      "text": "Is that what to get on the ball means?",
      "startMs": 12090,
      "endMs": 15270
    },
    {
      "text": "Hi, Anna.",
      "startMs": 16610,
      "endMs": 17030
    },
    {
      "text": "How was your day, Ben?",
      "startMs": 17490,
      "endMs": 18390
    },
    {
      "text": "Great.",
      "startMs": 18610,
      "endMs": 18910
    },
    {
      "text": "Very great.",
      "startMs": 19190,
      "endMs": 19710
    },
    {
      "text": "Very productive.",
      "startMs": 19950,
      "endMs": 20450
    },
    {
      "text": "I finished three reports and have only one more to do.",
      "startMs": 20730,
      "endMs": 23250
    },
    {
      "text": "Wow.",
      "startMs": 23650,
      "endMs": 23990
    },
    {
      "text": "You are on the ball.",
      "startMs": 24270,
      "endMs": 25890
    },
    {
      "text": "How did you do them so fast?",
      "startMs": 26410,
      "endMs": 28090
    },
    {
      "text": "Coffee.",
      "startMs": 28990,
      "endMs": 29490
    },
    {
      "text": "Lots of coffee.",
      "startMs": 29970,
      "endMs": 30810
    },
    {
      "text": "Do you want some?",
      "startMs": 30970,
      "endMs": 31630
    },
    {
      "text": "I'll get it.",
      "startMs": 31810,
      "endMs": 32310
    },
    {
      "text": "I'd love more coffee.",
      "startMs": 32390,
      "endMs": 33390
    },
    {
      "text": "Thank you.",
      "startMs": 33570,
      "endMs": 34150
    },
    {
      "text": "Sure, but maybe not that much coffee.",
      "startMs": 34150,
      "endMs": 38590
    },
    {
      "text": "Someone who is on the ball finishes work quickly and ahead of time.",
      "startMs": 40540,
      "endMs": 46780
    },
    {
      "text": "We can also say a person should get on the ball when they need to work faster or better.",
      "startMs": 47660,
      "endMs": 54400
    },
    {
      "text": "And that's English in a Minute.",
      "startMs": 55500,
      "endMs": 57480
    }
  ]
}