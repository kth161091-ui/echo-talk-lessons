  "sentences": [
    {
      "text": "Welcome to English in a Minute.",
      "startMs": 3860,
      "endMs": 6460
    },
    {
      "text": "Horses are big and strong.",
      "startMs": 7580,
      "endMs": 10000
    },
    {
      "text": "Writing them takes skill and strength.",
      "startMs": 10780,
      "endMs": 13800
    },
    {
      "text": "So is the idiom, hold your horses, about controlling horses?",
      "startMs": 14760,
      "endMs": 19940
    },
    {
      "text": "Oh, Andrew, can you help me with this box?",
      "startMs": 21720,
      "endMs": 24700
    },
    {
      "text": "Just a second, I'm almost done.",
      "startMs": 25120,
      "endMs": 27700
    },
    {
      "text": "Andrew, the box!",
      "startMs": 27980,
      "endMs": 29260
    },
    {
      "text": "I'm on the last page.",
      "startMs": 29880,
      "endMs": 31000
    },
    {
      "text": "It's really heavy!",
      "startMs": 31120,
      "endMs": 32040
    },
    {
      "text": "Hold your horses!",
      "startMs": 32040,
      "endMs": 33520
    },
    {
      "text": "What's in the box?",
      "startMs": 36760,
      "endMs": 38060
    },
    {
      "text": "Horses?",
      "startMs": 39040,
      "endMs": 39740
    },
    {
      "text": "Hold your horses is a way of telling someone to wait, to be patient.",
      "startMs": 43950,
      "endMs": 50110
    },
    {
      "text": "It's very informal.",
      "startMs": 51100,
      "endMs": 52300
    },
    {
      "text": "And depending on how you say it, it could sound rude.",
      "startMs": 53480,
      "endMs": 57040
    }
  ]
}